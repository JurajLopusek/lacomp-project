{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filafly/phosphor-icon-replacement": "^1.0",
        "filament/filament": "^3.2",
        "filipfonal/filament-log-manager": "^2.0",
        "laravel/framework": "^11.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "leandrocfe/filament-apex-charts": "^3.1",
        "livewire/livewire": "^3.5",
        "sentry/sentry-laravel": "^4.12",
        "spatie/laravel-permission": "^6.12",
        "timokoerber/laravel-one-time-operations": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.68",
        "jetbrains/phpstorm-attributes": "^1.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nunomaduro/larastan": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "fresh": [
            "composer install",
            "php artisan optimize:clear",
            "composer dump-autoload",
            "composer code-helper",
            "php artisan migrate:fresh",
            "php artisan operations:process",
            "php artisan db:seed"
        ],
        "format": [
            "./vendor/bin/php-cs-fixer fix"
        ],
        "code-helper": [
            "@php artisan ide-helper:models --write-mixin --reset --dir=\"app/Models\"",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "phpstan": [
            "composer config --global process-timeout 10000",
            "composer code-helper",
            "./vendor/bin/phpstan analyse --memory-limit=6G -v > code_analyse_output.txt"
        ],
        "rector": [
            "./vendor/bin/rector process --dry-run --config rector.php > code_rector_output.txt\n"
        ],
        "rector-write": [
            "./vendor/bin/rector process --config rector.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
