includes:
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    treatPhpDocTypesAsCertain: false

    paths:
        - app/

    level: 5

    scanFiles:
        - _ide_helper_models.php

    parallel:
        processTimeout: 3600.0

    ignoreErrors:
        - identifier: trait.unused
